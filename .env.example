PAYPAL_ENV="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""

# Set to "true" to enable a one-click "Complete test payment" button on
# checkout pages. Bypasses PayPal entirely — creates a paid Order and
# grants entitlements directly. ONLY for local development / staging.
# Set to "false" (or unset) in production.
NEXT_PUBLIC_TEST_PAYMENTS="false"

SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Tertiary Exams <noreply@exams.tertiaryinfotech.com>"

ANTHROPIC_API_KEY=""

ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="<set-a-strong-password>"
MARCUS_ADMIN_PASSWORD="<set-only-when-creating-this-admin>"
CKAD_LEARNER_PASSWORD="<set-only-when-creating-learners>"

# Cloudflare R2 image storage (or set in Admin > Settings > Image Storage)
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

# Google Gemini API
GEMINI_API_KEY=

# Google Cloud / Vertex AI (Gemini via ADC or a service-account key file kept OUTSIDE the repo;
# the service account needs the "Vertex AI User" role on the project)
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
